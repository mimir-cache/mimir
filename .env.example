# MIMIR backend configuration — copy to .env and adjust.

# --- Similarity thresholds ---
MIMIR_SEMANTIC_HIT_THRESHOLD=0.92
MIMIR_AMBIGUOUS_ZONE_LOW=0.80
MIMIR_COLLISION_CEILING=0.999

# --- Context-aware cache keys (feature flag — Risk 4 / ablation study) ---
MIMIR_CONTEXT_AWARE_ENABLED=false
MIMIR_CONTEXT_WINDOW_TURNS=3

# --- Admission / eviction ---
MIMIR_ADMISSION_THRESHOLD=0.50
MIMIR_MAX_CACHE_ENTRIES_PER_TENANT=10000
MIMIR_TTL_SECONDS=86400

# --- Infrastructure (all optional — in-process fallbacks used when unset) ---
# MIMIR_REDIS_URL=redis://localhost:6379/0
# MIMIR_ANTHROPIC_API_KEY=sk-ant-...
MIMIR_LLM_MODEL=
# Alternative real-LLM backend via OpenRouter (takes priority over Anthropic if both set)
# MIMIR_OPENROUTER_API_KEY=sk-or-v1-...
# MIMIR_OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# --- Embeddings ---
MIMIR_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Set true to use the deterministic hash embedder (no model download; tests/CI)
MIMIR_USE_HASH_EMBEDDER=false

# --- Auth ---
# Stable demo tenant keys (generated per process when unset — check startup logs)
# MIMIR_API_KEY_TENANT_A=mimir_tenant_a_change_me
# MIMIR_API_KEY_TENANT_B=mimir_tenant_b_change_me
# MIMIR_API_KEY_TENANT_C=mimir_tenant_c_change_me
# Admin endpoints are disabled until this is set:
# MIMIR_ADMIN_API_KEY=change_me_admin
